FROM node:18-bullseye-slim
WORKDIR /app

# Install build dependencies so native modules (sqlite3) can be compiled
RUN apt-get update && apt-get install -y build-essential python3 libsqlite3-dev --no-install-recommends \
	&& rm -rf /var/lib/apt/lists/*

COPY package*.json ./
# Install and build native modules inside the image
RUN npm install --build-from-source

COPY . .
EXPOSE 5002
CMD ["npm", "start"]